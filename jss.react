const person = {
  name: 'Bruno Mar',
  theme: {
    backgroundColor: 'black',
    color: 'gold',
    textAlign:'center',
    listStyle: 'none'

  },
  
  lista:{
    listStyle: 'none'
  },
  
  borda:{
    border: 'solid 3px #FFD700'
  }
};

function Lista(){
  return(
    <>
      <ul style={person.lista}>
        <li>Improve the videophone</li>
        <li>Prepare aeronautics lectures</li>
        <li>Work on the alcohol-fuelled engine</li>
        
      </ul>
  </>
  );
};

function Numero(){
  let numero = Math.floor(Math.random()*10+1)
  return(
    <>
      <h1>Seu numero da sorte é: {numero}</h1>
  </>)
};


export default function TodoList() {
  return (
    <div style={person.theme}>
      <h1>{person.name}'s </h1>
      <img
        className="avatar"
        src="https://i.guim.co.uk/img/media/8f1aa6d270f6765c6cc7ac1689c81cd64b290b86/133_0_1333_800/master/1333.jpg?width=1200&height=1200&quality=85&auto=format&fit=crop&s=d11138ec0241f044e40806254b34bb3c"
        alt="Bruno Mars"
        style={person.borda}
      />
      <Lista />
      <Numero />
    </div>
  );
}
